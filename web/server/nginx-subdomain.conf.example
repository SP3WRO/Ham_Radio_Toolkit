# nginx: subdomena dla wersji WWW Ham Radio Toolkit (zamień ham.example.pl na swoją subdomenę).
# Certyfikat HTTPS (wymagany przez iPhone'a dla GPS i instalacji na ekranie początkowym):
#   apt install certbot python3-certbot-nginx
#   certbot --nginx -d ham.example.pl
# Plik: /etc/nginx/sites-available/hamradio-toolkit  ->  ln -s do sites-enabled, potem: nginx -t && systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name ham.example.pl;
    # certbot dopisze tu przekierowanie na https
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ham.example.pl;

    # Ścieżki uzupełni certbot
    # ssl_certificate     /etc/letsencrypt/live/ham.example.pl/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ham.example.pl/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    gzip on;
    gzip_types text/css text/javascript application/javascript application/json application/manifest+json text/csv text/tab-separated-values text/plain image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Na przyszłość: most APRS-IS przez WebSocket (etap 2)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
