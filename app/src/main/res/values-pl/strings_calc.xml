    <string name="calc_dipole_tip2">Inverted V (kąt 90–120°): zacznij od tych samych wymiarów – zwykle trzeba skrócić o kilka procent.</string>
    <string name="calc_dipole_tip3">Impedancja ok. 50–75 Ω; balun prądowy 1:1 przy punkcie zasilania ogranicza prądy na oplocie.</string>
    <string name="calc_efhw_title">EFHW – półfalówka zasilana na końcu</string>
    <string name="calc_radiator">A – promiennik</string>
